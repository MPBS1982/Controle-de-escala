# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=controle-escala-talho
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Resend configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Vercel Cron secret for weekly RH reports
CRON_SECRET=

# Firebase Admin SDK credentials for server-side cron/reporting
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set the individual fields below instead of the JSON blob:
FIREBASE_ADMIN_PROJECT_ID=controle-escala-talho
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
