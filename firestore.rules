rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: employees
    // Fields: name (string), avatar (string), sectorId (string), roleId (string)
    //
    // Collection: sectors
    // Fields: name (string), color (string), icon (string)
    //
    // Collection: roles
    // Fields: name (string)
    //
    // Collection: shifts
    // Fields: employeeId (string), day (int), month (int), year (int), type (string), time (string), overtime (bool)
    //
    // Collection: special_schedules
    // Fields: name (string), date (string), status (string)
    //
    // Collection: special_schedule_assignments
    // Fields: specialScheduleId (string), employeeId (string)
    //
    // Collection: alerts
    // Fields: type (string), message (string), date (string), employeeId (string)
    //
    // Collection: config
    // Fields: value (string)
    //
    // Collection: users
    // Fields: name (string), email (string), role (string), avatar (string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          isMasterEmail());
    }

    function isSupervisor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'manager'];
    }

    function canEditOperationalData() {
      return isAdmin() || isSupervisor();
    }

    function isMasterEmail() {
      return isAuthenticated() &&
        request.auth.token.email == "sistemas@talhodelicatessen.com.br";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidEmployee(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.sectorId is string && data.roleId is string &&
             (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() < 500));
    }

    function isValidSector(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.color is string && data.color.size() < 20 &&
             (!('icon' in data) || data.icon == null || (data.icon is string && data.icon.size() < 50));
    }

    function isValidRole(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 50;
    }

    function isValidShift(data) {
      return data.employeeId is string &&
             data.day is int && data.day >= 1 && data.day <= 31 &&
             data.month is int && data.month >= 1 && data.month <= 12 &&
             data.year is int &&
             data.type is string && data.type.size() < 50 &&
             (!('time' in data) || data.time == null || (data.time is string && data.time.size() < 20)) &&
             (!('overtime' in data) || data.overtime == null || data.overtime is bool);
    }

    function isValidSpecialSchedule(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.date is string && data.date.size() < 50 &&
             (!('status' in data) || data.status == null || (data.status is string && data.status.size() < 50));
    }

    function isValidVacation(data) {
      return (!('employeeId' in data) || data.employeeId == null || data.employeeId is string) &&
             data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() < 100 &&
             data.sectorId is string &&
             data.sectorName is string && data.sectorName.size() > 0 && data.sectorName.size() < 100 &&
             data.startDate is string && data.startDate.size() == 10 &&
             data.endDate is string && data.endDate.size() == 10 &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() < 1000));
    }

    function isValidAssignment(data) {
      return data.specialScheduleId is string && data.employeeId is string;
    }

    function isValidAlert(data) {
      return data.type in ['error', 'warning', 'info'] &&
             data.message is string && data.message.size() < 500 &&
             data.date is string &&
             (!('title' in data) || (data.title is string && data.title.size() < 150)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 1000)) &&
             (!('reason' in data) || (data.reason is string && data.reason.size() < 1000)) &&
             (data.employeeId == null || data.employeeId is string);
    }

    function isValidAuditLog(data) {
      return data.entity in ['alerts', 'shifts'] &&
             data.action in ['create', 'update', 'delete', 'replace'] &&
             (!('alertId' in data) || (data.alertId is string)) &&
             (!('alertType' in data) || (data.alertType is string)) &&
             (!('alertTitle' in data) || (data.alertTitle is string)) &&
             (!('alertDescription' in data) || (data.alertDescription is string)) &&
             (!('alertDate' in data) || (data.alertDate is string)) &&
             (!('employeeId' in data) || (data.employeeId is string)) &&
             (!('employeeName' in data) || (data.employeeName is string)) &&
             (!('sectorId' in data) || (data.sectorId is string)) &&
             (!('reason' in data) || (data.reason is string)) &&
             (!('details' in data) || (data.details is string)) &&
             (!('previousType' in data) || (data.previousType is string)) &&
             (!('nextType' in data) || (data.nextType is string)) &&
             (!('day' in data) || (data.day is int)) &&
             (!('month' in data) || (data.month is int)) &&
             (!('year' in data) || (data.year is int)) &&
             (!('performedByUid' in data) || (data.performedByUid is string)) &&
             (!('performedByName' in data) || (data.performedByName is string)) &&
             (!('performedByEmail' in data) || (data.performedByEmail is string)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidConfig(data) {
      return data.value is string && data.value.size() < 1000;
    }

    function isValidUser(data, userId) {
      return data.uid is string && data.uid == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() < 100 &&
             data.role in ['admin', 'supervisor', 'manager', 'user'] &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() < 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidEmployee(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidSector(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidRole(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /{path=**}/shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidShift(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /special_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidSpecialSchedule(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /special_schedule_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidAssignment(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /vacations/{vacationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidVacation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if canEditOperationalData() && isValidAlert(request.resource.data);
      allow delete: if canEditOperationalData();
    }

    match /audit_logs/{logId} {
      allow read, create: if (canEditOperationalData() || isMasterEmail()) && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /config/{configKey} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data, userId) && 
                      (
                        isAdmin() ||
                        (isOwner(userId) && request.resource.data.role == 'user') ||
                        (isMasterEmail() && isOwner(userId) && request.resource.data.role == 'admin')
                      );
      allow update: if isAuthenticated() && isValidUser(request.resource.data, userId) && 
                      (
                        isAdmin() ||
                        (isOwner(userId) && request.resource.data.role == resource.data.role) ||
                        (isMasterEmail() && isOwner(userId) && request.resource.data.role == 'admin')
                      );
      allow delete: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
